# ── Server ───────────────────────────────────────────────────────────────────
# TCP port the Express server listens on (default: 3000)
PORT=3000

# Set to "production" in deployed environments
NODE_ENV=development

# ── Logging (Pino) ───────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
# Defaults: debug (dev), warn (test), info (production)
LOG_LEVEL=debug

# Pretty-print logs with pino-pretty (true = human-readable, false = JSON)
# Defaults: true (dev), false (test/production)
LOG_PRETTY=true

# Emit a debug log for every Socket.IO event (very verbose)
LOG_SOCKET_EVENTS=false

# ── Metrics (Prometheus) ─────────────────────────────────────────────────────
# Expose /metrics endpoint (default: true outside production, false in production)
METRICS_ENABLED=true

# Optional bearer token to protect /metrics scrapes.
# When set, requests must include:  Authorization: Bearer <token>
#                                or  x-metrics-token: <token>
# METRICS_AUTH_TOKEN=your-secret-token
# ── Admin console ─────────────────────────────────────────────────────────────
# All three vars must be set to enable the admin API.
# docker-compose.yml loads this file with env_file format: raw so bcrypt hashes
# containing "$" are preserved. Do not commit real admin credentials.

# Admin login username
# ADMIN_USERNAME=admin

# bcrypt hash of the admin password.
# Generate: node -e "require('bcryptjs').hash('yourpassword', 10).then(console.log)"
# ADMIN_PASSWORD_HASH=

# Secret used to sign admin session JWTs (min. 32 chars recommended).
# ADMIN_JWT_SECRET=
