{
  "name": "game-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "^11.0.0"
  },
  "scripts": {
    "dev": "pnpm -C apps/platform dev",
    "build": "pnpm -C apps/platform build && node games/blackout/scripts/copy-db-assets.mjs",
    "start": "pnpm -C apps/platform start",
    "typecheck": "pnpm -C apps/platform typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:blackout": "vitest run --project blackout",
    "test:imposter": "vitest run --project imposter",
    "test:secret-signals": "vitest run --project secret-signals",
    "test:flip7": "vitest run --project flip7",
    "test:scout": "vitest run --project scout",
    "test:e2e": "playwright test",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^5.1.16",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "pinia": "^3.0.4",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.9",
    "vue": "^3.5.39",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  },
  "overrides": {
    "diff": "^8.0.3",
    "esbuild": ">=0.25.0"
  }
}
